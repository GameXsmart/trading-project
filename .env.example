# Copy to .env and edit. .env is gitignored; never commit real values.
#
# Every setting in config/default.yaml can be overridden here with an MIE_ prefix,
# using __ to nest: MIE_<SECTION>__<KEY>.

# ---------------------------------------------------------------------- database
# Default is SQLite, which needs no infrastructure. For production:
# MIE_DATABASE__URL=postgresql+asyncpg://mie:CHANGEME@localhost:5432/mie
# MIE_DATABASE__URL=sqlite+aiosqlite:///./data/mie.db

# ------------------------------------------------------------------------- app
# MIE_APP__LOG_LEVEL=DEBUG
# MIE_APP__LOG_JSON=true
# MIE_APP__ENVIRONMENT=prod

# ------------------------------------------------------------------- ingestion
# MIE_INGESTION__POLL_INTERVAL_S=20
# MIE_INGESTION__MAX_CONCURRENCY=6
# MIE_INGESTION__COLLECT_DERIVATIVES=true

# ------------------------------------------------------------------- providers
# All Phase 1 providers use PUBLIC, READ-ONLY endpoints and need no credentials.
#
# If you ever add a keyed data provider, put the key here and nowhere else. Use a
# READ-ONLY key: this system has no order-execution path and must never hold a key
# that could place a trade or move funds.
# MIE_COINGECKO_API_KEY=
# MIE_CRYPTOPANIC_API_KEY=     # Phase 5 (news)

# Set if api.binance.com is geo-restricted where you run this:
# MIE_PROVIDERS__0__OPTIONS__USE_US_ENDPOINT=true
